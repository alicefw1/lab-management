<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.reserve.mapper.PatrolRecordMapper">
    <resultMap id="BaseResultMap" type="com.lab.reserve.entity.PatrolRecord">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="patrol_date" property="patrolDate"/>
        <result column="lab_id" property="labId"/>
        <result column="items" property="items"/>
        <result column="result" property="result"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="user_name" property="userName"/>
        <result column="lab_name" property="labName"/>
    </resultMap>
    <select id="selectList" resultMap="BaseResultMap">
        SELECT p.*, u.real_name AS user_name, lr.name AS lab_name
        FROM patrol_record p
        LEFT JOIN `user` u ON p.user_id = u.id
        LEFT JOIN lab_room lr ON p.lab_id = lr.id
        <where>
            <if test="userId != null">AND p.user_id = #{userId}</if>
        </where>
        ORDER BY p.patrol_date DESC
    </select>
    <insert id="insert" parameterType="com.lab.reserve.entity.PatrolRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO patrol_record(user_id, patrol_date, lab_id, items, result, status)
        VALUES(#{userId}, #{patrolDate}, #{labId}, #{items}, #{result}, #{status})
    </insert>
</mapper>
