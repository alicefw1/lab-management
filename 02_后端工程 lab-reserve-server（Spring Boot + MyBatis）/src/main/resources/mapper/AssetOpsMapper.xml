<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.reserve.mapper.AssetOpsMapper">
  <select id="selectSuppliers" resultType="map">SELECT * FROM supplier <where><if test="keyword!=null and keyword!=''">(supplier_name LIKE CONCAT('%',#{keyword},'%') OR contact_name LIKE CONCAT('%',#{keyword},'%'))</if><if test="status!=null">AND status=#{status}</if></where> ORDER BY rating DESC,id DESC</select>
  <insert id="insertSupplier" parameterType="map" useGeneratedKeys="true" keyProperty="id">INSERT INTO supplier(supplier_code,supplier_name,contact_name,phone,email,address,business_scope,rating,status) VALUES(#{supplierCode},#{supplierName},#{contactName},#{phone},#{email},#{address},#{businessScope},COALESCE(#{rating},5),COALESCE(#{status},1))</insert>
  <update id="updateSupplier" parameterType="map">UPDATE supplier <set><if test="supplierCode!=null">supplier_code=#{supplierCode},</if><if test="supplierName!=null">supplier_name=#{supplierName},</if><if test="contactName!=null">contact_name=#{contactName},</if><if test="phone!=null">phone=#{phone},</if><if test="email!=null">email=#{email},</if><if test="address!=null">address=#{address},</if><if test="businessScope!=null">business_scope=#{businessScope},</if><if test="rating!=null">rating=#{rating},</if><if test="status!=null">status=#{status},</if></set> WHERE id=#{id}</update>
  <delete id="deleteSupplier">DELETE FROM supplier WHERE id=#{id}</delete>
  <select id="selectMaintenancePlans" resultType="map">SELECT p.*,d.device_name,d.device_no,u.real_name AS creator_name,CASE WHEN p.next_date&lt;CURDATE() AND p.status=1 THEN 1 ELSE 0 END AS overdue FROM maintenance_plan p JOIN device d ON d.id=p.device_id LEFT JOIN `user` u ON u.id=p.creator_id <where><if test="status!=null">p.status=#{status}</if></where> ORDER BY overdue DESC,p.next_date</select>
  <insert id="insertMaintenancePlan" parameterType="map" useGeneratedKeys="true" keyProperty="id">INSERT INTO maintenance_plan(device_id,plan_name,cycle_days,last_date,next_date,content,responsible_name,status,creator_id) VALUES(#{deviceId},#{planName},COALESCE(#{cycleDays},90),#{lastDate},#{nextDate},#{content},#{responsibleName},COALESCE(#{status},1),#{creatorId})</insert>
  <update id="updateMaintenancePlan" parameterType="map">UPDATE maintenance_plan <set><if test="deviceId!=null">device_id=#{deviceId},</if><if test="planName!=null">plan_name=#{planName},</if><if test="cycleDays!=null">cycle_days=#{cycleDays},</if><if test="nextDate!=null">next_date=#{nextDate},</if><if test="content!=null">content=#{content},</if><if test="responsibleName!=null">responsible_name=#{responsibleName},</if><if test="status!=null">status=#{status},</if></set> WHERE id=#{id}</update>
  <delete id="deleteMaintenancePlan">DELETE FROM maintenance_plan WHERE id=#{id}</delete>
  <select id="selectMaintenanceRecords" resultType="map">SELECT r.*,p.plan_name,d.device_name,d.device_no,u.real_name AS operator_name FROM maintenance_record r JOIN maintenance_plan p ON p.id=r.plan_id JOIN device d ON d.id=p.device_id LEFT JOIN `user` u ON u.id=r.operator_id <where><if test="planId!=null">r.plan_id=#{planId}</if></where> ORDER BY r.maintenance_time DESC</select>
  <insert id="insertMaintenanceRecord" parameterType="map" useGeneratedKeys="true" keyProperty="id">INSERT INTO maintenance_record(plan_id,maintenance_time,content,result,cost,operator_id,attachment_url) VALUES(#{planId},NOW(),#{content},#{result},COALESCE(#{cost},0),#{operatorId},#{attachmentUrl})</insert>
  <update id="finishMaintenancePlan" parameterType="map">UPDATE maintenance_plan SET last_date=CURDATE(),next_date=DATE_ADD(CURDATE(),INTERVAL cycle_days DAY) WHERE id=#{planId}</update>
</mapper>
