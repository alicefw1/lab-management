<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.reserve.mapper.LabRoomMapper">
    <resultMap id="BaseResultMap" type="com.lab.reserve.entity.LabRoom">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="location" property="location"/>
        <result column="capacity" property="capacity"/>
        <result column="manager" property="manager"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="type_id" property="typeId"/>
        <result column="image_url" property="imageUrl"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="type_name" property="typeName"/>
    </resultMap>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT lr.*, lt.type_name
        FROM lab_room lr
        LEFT JOIN lab_type lt ON lr.type_id = lt.id
        <where>
            <if test="keyword != null and keyword != ''">
                AND (lr.name LIKE CONCAT('%', #{keyword}, '%') OR lr.location LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY lr.id
    </select>
    <select id="selectById" resultMap="BaseResultMap">
        SELECT lr.*, lt.type_name
        FROM lab_room lr
        LEFT JOIN lab_type lt ON lr.type_id = lt.id
        WHERE lr.id = #{id}
    </select>
    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM lab_room
    </select>
    <insert id="insert" parameterType="com.lab.reserve.entity.LabRoom" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO lab_room(name, location, capacity, manager, description, status, type_id, image_url)
        VALUES(#{name}, #{location}, #{capacity}, #{manager}, #{description}, #{status}, #{typeId}, #{imageUrl})
    </insert>
    <update id="updateById" parameterType="com.lab.reserve.entity.LabRoom">
        UPDATE lab_room
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="location != null">location = #{location},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="manager != null">manager = #{manager},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="typeId != null">type_id = #{typeId},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
        </set>
        WHERE id = #{id}
    </update>
    <delete id="deleteById">
        DELETE FROM lab_room WHERE id = #{id}
    </delete>
</mapper>
