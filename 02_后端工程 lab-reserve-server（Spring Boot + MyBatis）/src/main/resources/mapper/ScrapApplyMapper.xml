<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.reserve.mapper.ScrapApplyMapper">
    <resultMap id="BaseResultMap" type="com.lab.reserve.entity.ScrapApply">
        <id column="id" property="id"/>
        <result column="device_id" property="deviceId"/>
        <result column="user_id" property="userId"/>
        <result column="reason" property="reason"/>
        <result column="status" property="status"/>
        <result column="audit_user_id" property="auditUserId"/>
        <result column="audit_time" property="auditTime"/>
        <result column="audit_remark" property="auditRemark"/>
        <result column="create_time" property="createTime"/>
        <result column="device_name" property="deviceName"/>
        <result column="device_no" property="deviceNo"/>
        <result column="user_name" property="userName"/>
    </resultMap>
    <select id="selectList" resultMap="BaseResultMap">
        SELECT s.*, d.device_name, d.device_no, u.real_name AS user_name
        FROM scrap_apply s
        LEFT JOIN device d ON s.device_id = d.id
        LEFT JOIN `user` u ON s.user_id = u.id
        <where>
            <if test="status != null">AND s.status = #{status}</if>
            <if test="userId != null">AND s.user_id = #{userId}</if>
        </where>
        ORDER BY s.create_time DESC
    </select>
    <select id="selectById" resultMap="BaseResultMap">
        SELECT s.*, d.device_name, d.device_no, u.real_name AS user_name
        FROM scrap_apply s
        LEFT JOIN device d ON s.device_id = d.id
        LEFT JOIN `user` u ON s.user_id = u.id
        WHERE s.id = #{id}
    </select>
    <insert id="insert" parameterType="com.lab.reserve.entity.ScrapApply" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO scrap_apply(device_id, user_id, reason, status)
        VALUES(#{deviceId}, #{userId}, #{reason}, #{status})
    </insert>
    <update id="updateById" parameterType="com.lab.reserve.entity.ScrapApply">
        UPDATE scrap_apply
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="auditUserId != null">audit_user_id = #{auditUserId},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
