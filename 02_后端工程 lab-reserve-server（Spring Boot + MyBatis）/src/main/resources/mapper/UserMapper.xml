<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.reserve.mapper.UserMapper">
    <resultMap id="BaseResultMap" type="com.lab.reserve.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="role_id" property="roleId"/>
        <result column="role_code" property="roleCode"/>
        <result column="role_name" property="roleName"/>
        <result column="status" property="status"/>
        <result column="credit_score" property="creditScore"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT u.*, r.role_code, r.role_name
        FROM `user` u
        LEFT JOIN role r ON u.role_id = r.id
        WHERE u.username = #{username}
        LIMIT 1
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT u.*, r.role_code, r.role_name
        FROM `user` u
        LEFT JOIN role r ON u.role_id = r.id
        WHERE u.id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT u.*, r.role_code, r.role_name
        FROM `user` u
        LEFT JOIN role r ON u.role_id = r.id
        <where>
            <if test="keyword != null and keyword != ''">
                AND (u.username LIKE CONCAT('%', #{keyword}, '%')
                     OR u.real_name LIKE CONCAT('%', #{keyword}, '%')
                     OR u.phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null">AND u.status = #{status}</if>
            <if test="roleId != null">AND u.role_id = #{roleId}</if>
        </where>
        ORDER BY u.id DESC
    </select>

    <select id="countByUsername" resultType="int">
        SELECT COUNT(*) FROM `user` WHERE username = #{username}
    </select>

    <insert id="insert" parameterType="com.lab.reserve.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user`(username, password, real_name, phone, email, role_id, status)
        VALUES(#{username}, #{password}, #{realName}, #{phone}, #{email}, #{roleId}, #{status})
    </insert>

    <update id="updateById" parameterType="com.lab.reserve.entity.User">
        UPDATE `user`
        <set>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="roleId != null">role_id = #{roleId},</if>
            <if test="password != null">password = #{password},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE `user` SET status = #{status} WHERE id = #{id}
    </update>

    <update id="resetPassword">
        UPDATE `user` SET password = #{password} WHERE id = #{id}
    </update>

    <update id="updateCreditScore">
        UPDATE `user` SET credit_score = #{creditScore} WHERE id = #{id}
    </update>
</mapper>
