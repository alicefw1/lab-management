<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lab.reserve.mapper.RoleMapper">
    <select id="selectList" resultType="com.lab.reserve.entity.Role">
        SELECT id, role_code, role_name FROM role ORDER BY id
    </select>
    <select id="selectById" resultType="com.lab.reserve.entity.Role">
        SELECT id, role_code, role_name FROM role WHERE id = #{id}
    </select>
</mapper>
